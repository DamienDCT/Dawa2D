:root {
}

.panel-background {
    background-color: rgba(0, 0, 0, 0.863);
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-grow: 1;
}

.hidden {
    display: none;
}

.money-label {
    color: rgb(255, 255, 255);
    scale: 1 1;
    transform-origin: right center; /* ou left / center selon ton layout */
    transition-property: color, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.money-gain {
    color: rgb(90, 230, 110);
    scale: 1.2 1.2;
}

.money-loss {
    color: rgb(240, 80, 80);
    scale: 1.2 1.2;
}