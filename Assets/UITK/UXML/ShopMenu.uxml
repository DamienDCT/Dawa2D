    <ui:VisualElement name="Panel" class="panel-background" style="flex-direction: row; flex-grow: 1;">
        <ui:VisualElement name="ListPart" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(212, 0, 0); background-size: 100% 100%;">
