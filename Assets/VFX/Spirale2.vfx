  m_Script: {fileID: 11500000, guid: 3dce580c03fa4404bb6d87662050fbf1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966674976}
  m_Children: []
  m_UIPosition: {x: 234, y: 435}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661614896}
  - {fileID: 8926484042661614897}
  - {fileID: 8926484042661614898}
  - {fileID: 8926484042661614931}
  m_OutputSlots:
  - {fileID: 8926484042661614927}
  m_OperatorName: Custom HLSL
  m_HLSLCode: "void CustomSpiral(in float age, in float rotationSpeed, in float maxRadius,
    in float lifetime, out float2 spiralPosition)\r\n{\r\n    // Age normalis\xE9
    [0,1]\r\n    float t = saturate(age / lifetime);\r\n\r\n    // Nombre total de
    tours voulus\r\n    float totalTurns = 3.0; // Ajuste \xE0 2, 3, 4... selon l\u2019effet\r\n\r\n   
    // Angle = avancement du temps * nombre de tours * 2\u03C0\r\n    float angle
    = t * totalTurns * 6.283185; // 6.283185 = 2*PI\r\n\r\n    // Rayon qui diminue
    jusqu\u2019\xE0 0\r\n    float radius = maxRadius * (1.0 - t);\r\n\r\n    //
    Position\r\n    spiralPosition.x = cos(angle) * radius;\r\n    spiralPosition.y
    = sin(angle) * radius;\r\n}\r\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: CustomSpiral
    selectedIndex: 0
